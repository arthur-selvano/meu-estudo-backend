# Copie este arquivo para `.env` e preencha os valores.
# O `.env` é ignorado pelo Git e NUNCA deve ser versionado.
#
# Gere segredos fortes, por exemplo:
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9'   # senha do banco
#   openssl rand -base64 64                        # chave JWT (>= 32 bytes)
#
# Para carregar no shell antes de rodar a API:
#   set -a; source .env; set +a

# --- PostgreSQL local (docker compose) ---
POSTGRES_USER=meuestudos_user
POSTGRES_PASSWORD=substitua-por-uma-senha-forte-e-exclusiva
POSTGRES_DB=meuestudos_db
POSTGRES_PORT=5432

# --- API (mesmas variáveis para dotnet run e docker compose) ---
# O .NET e o Docker Compose leem a configuração Jwt:* destas variáveis.
Jwt__Key=substitua-por-uma-chave-aleatoria-com-no-minimo-32-bytes
Jwt__Issuer=MeuEstudo.Api
Jwt__Audience=MeuEstudo.Frontend

# Connection string usada quando a API roda fora do Docker (dotnet run).
# A variável de ambiente tem precedência sobre appsettings.*.json.
ConnectionStrings__DefaultConnection='Host=localhost;Port=5432;Database=meuestudos_db;Username=meuestudos_user;Password=substitua-por-uma-senha-forte-e-exclusiva'

# --- Produção (exemplos; configure no painel do Render/secret manager) ---
# ConnectionStrings__DefaultConnection=Host=...;Port=5432;Database=...;Username=...;Password=...;SSL Mode=Require
# Jwt__Key=...
# Jwt__Issuer=MeuEstudo.Api
# Jwt__Audience=MeuEstudo.Frontend
# Cors__AllowedOrigins__0=https://seu-frontend.example.com
